{
  "framework": "vite",
  "functions": {
    "api/gemini.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/feedback.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|.*\\.(?:ico|js|mjs|css|png|jpg|jpeg|svg|webp|woff|woff2|ttf|eot|json|map|txt|xml)).*)",
      "destination": "/index.html"
    }
  ]
}
